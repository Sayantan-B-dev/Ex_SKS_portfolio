# MongoDB Atlas : shared Blue Eye Entertainment cluster.
# This site only ever reads and writes its own MONGODB_PORTFOLIO_COLLECTION
# collection. The other app's `artists` collection is never touched.
MONGODB_URI=mongodb+srv://USER:PASSWORD@blueeyeentertainment.6a3otco.mongodb.net/?appName=BlueEyeEntertainment
MONGODB_DB_NAME=BlueEyeEntertainment
MONGODB_PORTFOLIO_COLLECTION=SamratPortfolio
## backup command : mongodump --uri="$MONGODB_URI" --out="./mongodb-cluster-backup"


# Public production URL used for canonical links, OG URLs, and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.samratsarkar.co

# Blog author login : cookie session, no database involved.
BLOG_AUTHOR_NAME=Samrat Sarkar
BLOG_AUTHOR_USERNAME=admin
BLOG_AUTHOR_PASSWORD=replace-with-a-strong-password
BLOG_SESSION_SECRET=replace-with-a-long-random-secret

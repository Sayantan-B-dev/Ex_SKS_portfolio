# MongoDB Atlas : shared Blue Eye Entertainment cluster.
# This site only ever reads and writes its own MONGODB_PORTFOLIO_COLLECTION
# collection. The other app's `artists` collection is never touched.
MONGODB_URI=mongodb+srv://USER:PASSWORD@blueeyeentertainment.6a3otco.mongodb.net/?appName=BlueEyeEntertainment
MONGODB_DB_NAME=BlueEyeEntertainment
MONGODB_PORTFOLIO_COLLECTION=SamratPortfolio
## backup command : mongodump --uri="$MONGODB_URI" --out="./mongodb-cluster-backup"


# Public production URL used for canonical links, OG URLs, and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.samratsarkar.co

# ImageKit : blog and gallery image storage, confined to /sks-portfolio/blogs.
# The app only ever creates files there, plus removing the images that a story or
# gallery photo owns when that item is deleted (never a folder, never another
# item's media). Everything else in the account is left alone; cleaning up any
# other media is a manual action for the account owner.
# Run `npm run setup:imagekit` once to create the folders.
# NOTE: the endpoint is also what whitelists ImageKit for `next/image`
# (see imageKitPattern in next.config.ts), so keep it URL-only, no path.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# The live environment spells the two keys without the second "A"; both
# spellings are accepted in code, so match whatever your environment already has.
IMGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx

# Blog author login : cookie session, no database involved.
BLOG_AUTHOR_NAME=Samrat Sarkar
BLOG_AUTHOR_USERNAME=admin
BLOG_AUTHOR_PASSWORD=replace-with-a-strong-password
BLOG_SESSION_SECRET=replace-with-a-long-random-secret
